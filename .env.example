# LLM provider credentials used by the `openai-agents` runtime.
# Required for pipeline analysis runs from the CLI or Next.js UI.
OPENAI_API_KEY=your_api_key_here

# Optional: use an OpenAI-compatible base URL instead of the default provider endpoint.
OPENAI_BASE_URL=

# Optional: default model used by the shared OpenAI-compatible agent model factory.
OPENAI_MODEL=gpt-4.1-mini

# Local development keeps using local PostgreSQL. Production overrides these
# server-side in Modal: DATABASE_URL uses the Supabase transaction pooler on
# port 6543; DIRECT_DATABASE_URL uses the direct endpoint or session pooler on
# port 5432. Never expose either URL as NEXT_PUBLIC_*.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fpl_scout
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fpl_scout
DATABASE_POOL_MODE=auto
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=5
TRANSCRIPT_FAILURE_RETRY_HOURS=24

# Publication window around an explicitly supplied gameweek deadline.
VIDEO_SELECTION_WINDOW_DAYS_BEFORE=10
VIDEO_SELECTION_WINDOW_DAYS_AFTER=2

# Optional: API runtime settings.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ENVIRONMENT=development

# Machine-only credential for trusted scripts, cron jobs, and CI/CD. Never send
# this token to the browser.
PIPELINE_API_TOKEN=

# Clerk authenticates human administrators. Authorized parties is a
# comma-separated allowlist of frontend origins, and admin IDs is a
# comma-separated allowlist of Clerk user IDs.
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-production-domain.com
CLERK_ADMIN_USER_IDS=user_abc123,user_def456

# Optional: route transcript requests through Webshare to reduce YouTube IP blocking.
ENABLE_WEBSHARE_PROXY=false
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
